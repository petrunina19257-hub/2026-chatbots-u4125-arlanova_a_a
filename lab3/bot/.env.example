# Токен от @BotFather
BOT_TOKEN=123456:replace_me

# --- Режим запуска ---
# polling — бот сам опрашивает Telegram (просто запуск на компьютере)
# webhook — Telegram присылает обновления на WEBHOOK_URL (ngrok)
MODE=webhook
# Адрес из ngrok, без /webhook на конце
WEBHOOK_URL=https://xxxx-xx-xx.ngrok-free.app
# Порт, который пробрасывает ngrok (ngrok http 8000)
PORT=8000
# Любая случайная строка: Telegram будет присылать её в заголовке, чужие запросы отклоняются
WEBHOOK_SECRET=change_me_to_random_string

# Твой Telegram ID (узнать: отправь боту /admin). Несколько — через запятую
ADMIN_IDS=

# --- Общие настройки ---
TIMEZONE=Europe/Moscow
DIGEST_TIME=09:00
DB_PATH=tasks.db
LOG_FILE=bot.log

# --- Google Таблица (необязательно) ---
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
GOOGLE_SHEET_NAME=Tasks
