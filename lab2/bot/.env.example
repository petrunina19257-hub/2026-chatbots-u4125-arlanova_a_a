# Токен от @BotFather
BOT_TOKEN=123456:replace_me
# Часовой пояс для дедлайнов и напоминаний
TIMEZONE=Europe/Moscow
# Во сколько присылать утренний дайджест
DIGEST_TIME=09:00
# Файл базы данных SQLite
DB_PATH=tasks.db

# --- Google Таблица (необязательно) ---
# ID из ссылки https://docs.google.com/spreadsheets/d/<ВОТ_ЭТОТ_ID>/edit
GOOGLE_SHEET_ID=
# JSON-ключ сервисного аккаунта Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
# Имя листа внутри таблицы
GOOGLE_SHEET_NAME=Tasks
